#!/usr/bin/env bash

# Credits: https://github.com/ThePrimeagen/.dotfiles/blob/master/bin/.local/scripts/tmux-sessionizer
# -hd / --herdr opens a Herdr space instead of a tmux session.
# -rx / --rex opens a Rex session instead of a tmux session.

usage() {
    echo "usage: tms [-hd|--herdr | -rx|--rex] [--work] [dir]" >&2
}

REX_APP=com.superlogical.rex

ensure_herdr() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "tms: jq not found" >&2
        return 1
    fi

    herdr-app status >/dev/null 2>&1 && return 0

    open -a Herdr >/dev/null 2>&1 || {
        echo "tms: could not open Herdr" >&2
        return 1
    }

    for _ in {1..100}; do
        herdr-app status >/dev/null 2>&1 && return 0
        sleep 0.1
    done

    echo "tms: Herdr did not start" >&2
    return 1
}

space_id() {
    herdr-app ls 2>/dev/null |
        jq -r --arg name "$1" 'first(.spaces[]? | select(.name == $name and .machine == null) | .id) // empty'
}

open_space() {
    local dir=$1 name id

    name=$(basename "$dir" | tr . _)
    id=$(space_id "$name")

    if [[ -n $id ]]; then
        herdr-app do space.select --id "$id" >/dev/null
    else
        herdr-app do space.new --name "$name" --folder "$dir" >/dev/null
    fi
}

rex_app_running() {
    "$REX" client ls --json 2>/dev/null |
        jq -e 'any(.clients[]?; .info.kind == "app")' >/dev/null
}

ensure_rex() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "tms: jq not found" >&2
        return 1
    fi

    REX=$(command -v rex 2>/dev/null ||
        ls -d /Applications/Rex*.app/Contents/Helpers/"Rex Server.rex"/Contents/MacOS/rex 2>/dev/null | head -1)
    if [[ -z $REX ]]; then
        echo "tms: rex not found" >&2
        return 1
    fi

    rex_app_running && return 0

    open -b "$REX_APP" >/dev/null 2>&1 || {
        echo "tms: could not open Rex" >&2
        return 1
    }

    for _ in {1..100}; do
        rex_app_running && return 0
        sleep 0.1
    done

    echo "tms: Rex did not start" >&2
    return 1
}

name_of() { basename "$1" | tr . _; }

ensure_backend() {
    case $backend in
        herdr) ensure_herdr ;;
        rex) ensure_rex ;;
    esac
}

open_dir() {
    local name
    name=$(name_of "$1")

    case $backend in
        tmux) tmux has-session -t="$name" 2>/dev/null || tmux new-session -ds "$name" -c "$1" ;;
        herdr) open_space "$1" ;;
    esac
}

focus_dir() {
    local name
    name=$(name_of "$1")

    case $backend in
        tmux)
            if [[ -z ${TMUX:-} && -z $(pgrep tmux) ]]; then
                exec tmux attach -t="$name"
            fi
            tmux switch-client -t="$name"
            ;;
        herdr)
            open_space "$1"
            open -a Herdr >/dev/null 2>&1
            ;;
    esac
}

backend=tmux
work=0
dirs=()

for arg in "$@"; do
    case "$arg" in
        -hd|--herdr) backend=herdr ;;
        -rx|--rex) backend=rex ;;
        --work) work=1 ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "tms: unknown option: $arg" >&2; usage; exit 2 ;;
        *) dirs+=("$arg") ;;
    esac
done

if (( work )); then
    workfile="$HOME/.tms.work"
    if [[ ! -f $workfile ]]; then
        echo "~/.tms.work not found" >&2
        exit 1
    fi

    ensure_backend || exit 1

    if [[ $backend == rex ]]; then
        exec "$REX" do pick_work
    fi

    first=""
    while IFS= read -r dir; do
        [[ -z "$dir" || "$dir" == \#* ]] && continue
        dir="${dir/#\~/$HOME}"
        [[ -z $first ]] && first="$dir"

        if ! open_dir "$dir"; then
            echo "tms: could not open $dir" >&2
            exit 1
        fi
    done < "$workfile"

    if [[ -n $first ]]; then
        focus_dir "$first" || exit 1
    fi
    exit 0
fi

if (( ${#dirs[@]} > 1 )); then
    usage
    exit 2
fi

selected="${dirs[0]:-}"
if [[ -z $selected ]]; then
    if [[ $backend == rex ]]; then
        ensure_backend || exit 1
        exec "$REX" do pick_project
    fi
    selected=$(find ~/Code ~/Documents ~/Work ~/Repos ~/Projects -maxdepth 1 -type d 2>/dev/null | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

if [[ $selected != /* ]]; then
    selected=$(cd "$selected" 2>/dev/null && pwd) || {
        echo "tms: no such directory: $selected" >&2
        exit 1
    }
fi

ensure_backend || exit 1

if [[ $backend == rex ]]; then
    exec "$REX" do open_session "dir=$selected"
fi

open_dir "$selected" || exit 1
focus_dir "$selected" || exit 1
